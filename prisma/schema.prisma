datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id            String   @id @default(cuid())
  brand         String
  name          String
  price         Int
  originalPrice Int?
  image         String
  rating        Float    @default(0.0)
  reviews       Int      @default(0)
  category      String   @default("General")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
